# Postgres-forbindelse (fx fra Neon eller Vercel Postgres)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Hemmelig nøgle til login-sessioner (generér fx med: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Sidens adresse (lokalt: http://localhost:3000, i produktion jeres domæne)
BETTER_AUTH_URL=http://localhost:3000

# Kommasepareret liste af e-mails, der automatisk bliver admin, når kontoen oprettes
ADMIN_EMAILS=
